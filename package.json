{
  "name": "zapassist-firefox-android",
  "version": "0.1.45",
  "private": true,
  "type": "module",
  "description": "ZapAssist — Firefox for Android port of the Zapee Assistant browser extension",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "node scripts/build.mjs --check-only",
    "parity": "node scripts/check-parity.mjs",
    "test:origin": "node scripts/test-origin-pattern.mjs",
    "lint": "web-ext lint --source-dir extension",
    "start:android": "web-ext run --target firefox-android --source-dir extension --firefox-apk org.mozilla.fenix",
    "start:desktop": "web-ext run --source-dir extension",
    "build:xpi": "web-ext build --source-dir extension --artifacts-dir web-ext-artifacts"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "^1.48.0",
    "web-ext": "^8.3.0"
  }
}
